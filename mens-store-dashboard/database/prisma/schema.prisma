generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  sessions  Session[]
  auditEvents AuditEvent[]
  categories Category[]
  products Product[]
  warehouses Warehouse[]
  customers Customer[]
  sales Sale[]
  salesReturns SalesReturn[]
  inventoryTransactions InventoryTransaction[]
  treasuryTransactions TreasuryTransaction[]
}

enum Role {
  ADMIN
  FINANCE
  MANAGER
  CASHIER
  WAREHOUSE
}

enum InventoryMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALE_ISSUE
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  REVERSAL
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  INSTAPAY
  CREDIT
}

enum SaleStatus {
  POSTED
  VOIDED
}

enum ReturnStatus {
  PENDING_APPROVAL
  POSTED
  VOIDED
}

enum TreasuryTransactionType {
  SALE_RECEIPT
  RETURN_REFUND
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  email          String
  passwordHash   String
  role           Role
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sessions       Session[]
  auditEvents    AuditEvent[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
}

model Session {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash      String   @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUserId    String?
  actorUser      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model Category {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  sku            String
  barcode        String?
  salePrice      Decimal  @db.Decimal(19, 4)
  costPrice      Decimal  @db.Decimal(19, 4)
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inventoryTransactions InventoryTransaction[]
  saleLines SaleLine[]
  returnLines ReturnLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, active])
  @@index([organizationId, categoryId])
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inventoryTransactions InventoryTransaction[]
  sales Sale[]
  salesReturns SalesReturn[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legacyId       Int?
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  creditLimit    Decimal  @default(0) @db.Decimal(19, 4)
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sales          Sale[]
  salesReturns   SalesReturn[]

  @@unique([organizationId, legacyId])
  @@index([organizationId, active, name])
  @@index([organizationId, phone])
}

model Sale {
  id             String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  actorUserId    String
  subtotal       Decimal    @db.Decimal(19, 4)
  discount       Decimal    @db.Decimal(19, 4)
  total          Decimal    @db.Decimal(19, 4)
  status         SaleStatus @default(POSTED)
  idempotencyKey String?
  occurredAt     DateTime
  createdAt      DateTime   @default(now())
  lines          SaleLine[]
  payments       SalePayment[]
  returns        SalesReturn[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, occurredAt])
  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, warehouseId, occurredAt])
}

model SaleLine {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  lineNumber  Int
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  sku         String
  quantity    Decimal  @db.Decimal(19, 4)
  unitPrice   Decimal  @db.Decimal(19, 4)
  discount    Decimal  @db.Decimal(19, 4)
  total       Decimal  @db.Decimal(19, 4)

  @@unique([saleId, lineNumber])
  @@index([productId])
  returnLines ReturnLine[]
}

model SalePayment {
  id        String        @id @default(uuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(19, 4)
  createdAt DateTime      @default(now())

  @@index([saleId, method])
}

model SalesReturn {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  saleId         String?
  sale           Sale?        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  actorUserId    String
  approvedByUserId String?
  reason         String
  total          Decimal      @db.Decimal(19, 4)
  status         ReturnStatus @default(POSTED)
  idempotencyKey String?
  occurredAt     DateTime
  createdAt      DateTime     @default(now())
  lines          ReturnLine[]
  payments       ReturnPayment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, saleId, occurredAt])
  @@index([organizationId, status, occurredAt])
  @@index([organizationId, warehouseId, occurredAt])
}

model ReturnLine {
  id             String       @id @default(uuid())
  salesReturnId  String
  salesReturn    SalesReturn  @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  saleLineId     String?
  saleLine       SaleLine?    @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(19, 4)
  unitPrice      Decimal      @db.Decimal(19, 4)
  total          Decimal      @db.Decimal(19, 4)

  @@index([saleLineId])
  @@index([productId])
}

model ReturnPayment {
  id             String        @id @default(uuid())
  salesReturnId  String
  salesReturn    SalesReturn   @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(19, 4)
  createdAt      DateTime      @default(now())

  @@index([salesReturnId, method])
}

model TreasuryTransaction {
  id             String                  @id @default(uuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type           TreasuryTransactionType
  paymentMethod  PaymentMethod
  amount         Decimal                 @db.Decimal(19, 4)
  sourceType     String
  sourceId       String
  actorUserId    String
  occurredAt     DateTime
  createdAt      DateTime                @default(now())

  @@index([organizationId, occurredAt, paymentMethod])
  @@index([organizationId, sourceType, sourceId])
}

model InventoryTransaction {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  type           InventoryMovementType
  quantity       Decimal  @db.Decimal(19, 4)
  referenceType  String
  referenceId    String
  idempotencyKey String?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, warehouseId, productId, occurredAt])
  @@index([organizationId, productId, occurredAt])
}
